#
# Canonical pin data for the vendored OmniDecide C kernel source.
# Maintained by hand; verified by scripts/verify-kernel-source.sh and
# enforced by fetch-kernel.sh.  See docs/WASM-STATUS.md for provenance.

# Kernel release the integration targets.
ODK_EXPECTED_VERSION=2.0.0

# Commit GitHub stamped on the delivered source archive
# (omnidecide-c-main.zip; the archive comment carries the snapshot SHA).
ODK_SNAPSHOT_COMMIT=561fdb8ae43a4610d3df92cde5ba0a0ac5f63393
ODK_SNAPSHOT_ARCHIVE=omnidecide-c-main.zip
ODK_SNAPSHOT_RETRIEVED=2026-11-04

# Pin from an earlier internal engineering review.  The upstream
# repository is not anonymously reachable, so this commit could not be
# re-fetched in the release environment; the user-supplied archive above
# is authoritative for this release (documented in docs/WASM-STATUS.md).
ODK_PREVIOUS_PIN=a2e688af1641cd56d884a20e9069d566c54ee3e6

# Source manifest fingerprint of vendor/omnidecide-c/
# (algorithm pinned in scripts/source-manifest.sh).
ODK_VENDOR_FINGERPRINT=151754b2fcd7b5db8101ca458caced68e11725dc7ca66f8a79c6293b1b392f1a

# File count of the vendored snapshot (for quick integrity sanity).
ODK_VENDOR_FILE_COUNT=118
